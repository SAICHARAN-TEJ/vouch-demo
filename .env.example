# ------------------------------------------------------------------
# Vouch — environment configuration
#
# Copy this file to `.env.local` and fill in your values.
# The app runs fully on LOCAL SEEDED DATA if these are left blank —
# it auto-upgrades to Supabase the moment valid credentials are present.
# ------------------------------------------------------------------

# Supabase project URL (Project Settings → API → Project URL)
VITE_SUPABASE_URL=

# Supabase anon/public key (Project Settings → API → anon public).
# This key is public-by-design and protected by RLS. Do NOT put the
# service_role key here or anywhere in the frontend.
VITE_SUPABASE_ANON_KEY=

# Optional: override the MapLibre style URL. Defaults to an OSM raster
# style built into the app if left blank. A stylized fallback map renders
# automatically if tiles fail to load.
VITE_MAP_STYLE_URL=
